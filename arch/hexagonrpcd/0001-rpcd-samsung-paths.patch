From dc34f9c4e06d22cf407cbdeec697ede5a334e5e6 Mon Sep 17 00:00:00 2001
From: tarpediem <tarpediem@gmail.com>
Date: Tue, 17 Nov 2026 23:19:46 +0700
Subject: [PATCH] rpcd: Samsung paths: registry/../sns_reg_version,
 /sys/class/sensors/ssc_core/ssc_hw_rev

The Samsung SLPI firmware of the Galaxy Tab S7+ (gts7xl) reads the registry version file
next to the registry directory and the board revision from a Samsung sysfs file.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 hexagonrpcd/rpcd_builder.c | 34 +++++++++++++++++++++++++++++++---
 1 file changed, 31 insertions(+), 3 deletions(-)

diff --git a/hexagonrpcd/rpcd_builder.c b/hexagonrpcd/rpcd_builder.c
index d374958..6da6f1a 100644
--- a/hexagonrpcd/rpcd_builder.c
+++ b/hexagonrpcd/rpcd_builder.c
@@ -31,6 +31,8 @@
 #define SENSORS_CONFIG		"/sensors/config/"
 #define SENSORS_REGISTRY	"/sensors/registry/"
 #define SNS_REG_CONFIG		"/sensors/sns_reg.conf"
+#define SNS_REG_VERSION		"/sensors/sns_reg_version"
+#define SSC_HW_REV		"/sensors/ssc_hw_rev"
 #define SYSFS_SOCINFO		"/socinfo/"
 
 static struct hexagonfs_dirent *hfs_mkdir(const char *name, size_t n_ents, ...)
@@ -112,6 +114,7 @@ static struct hexagonfs_dirent *hfs_map_or_empty(const char *name, const char *p
 struct hexagonfs_dirent *construct_root_dir(const char *prefix, const char *dsp)
 {
 	char *acdbdata, *dsp_libs, *sns_cfg, *sns_reg, *sns_reg_config, *socinfo;
+	char *sns_reg_version, *ssc_hw_rev;
 	size_t n_prefix;
 	struct hexagonfs_dirent *persist_dir, *vendor_dir;
 
@@ -122,6 +125,18 @@ struct hexagonfs_dirent *construct_root_dir(const char *prefix, const char *dsp)
 	sns_reg = malloc(n_prefix + strlen(SENSORS_REGISTRY) + 1);
 	sns_reg_config = malloc(n_prefix + strlen(SNS_REG_CONFIG) + 1);
 	socinfo = malloc(n_prefix + strlen(SYSFS_SOCINFO) + 1);
+	sns_reg_version = malloc(n_prefix + strlen(SNS_REG_VERSION) + 1);
+	ssc_hw_rev = malloc(n_prefix + strlen(SSC_HW_REV) + 1);
+
+	if (sns_reg_version != NULL) {
+		strcpy(sns_reg_version, prefix);
+		strcat(sns_reg_version, SNS_REG_VERSION);
+	}
+
+	if (ssc_hw_rev != NULL) {
+		strcpy(ssc_hw_rev, prefix);
+		strcat(ssc_hw_rev, SSC_HW_REV);
+	}
 
 	dsp_libs = malloc(n_prefix + strlen(DSP_LIBS) + strlen(dsp) + 1);
 
@@ -162,8 +177,13 @@ struct hexagonfs_dirent *construct_root_dir(const char *prefix, const char *dsp)
 	 */
 	persist_dir = hfs_mkdir("persist", 1,
 				hfs_mkdir("sensors", 1,
-					hfs_mkdir("registry", 1,
-						hfs_map("registry", sns_reg)
+					/*
+					 * Samsung (gts7xl): the registry version
+					 * file sits next to the registry directory.
+					 */
+					hfs_mkdir("registry", 2,
+						hfs_map("registry", sns_reg),
+						hfs_map_or_empty("sns_reg_version", sns_reg_version)
 					)
 				)
 		      );
@@ -189,9 +209,17 @@ struct hexagonfs_dirent *construct_root_dir(const char *prefix, const char *dsp)
 				)
 			),
 			persist_dir,
-			hfs_mkdir("sys", 1,
+			hfs_mkdir("sys", 2,
 				hfs_mkdir("devices", 1,
 					hfs_map_or_empty("soc0", socinfo)
+				),
+				/* Samsung: board revision read through sns_reg_config */
+				hfs_mkdir("class", 1,
+					hfs_mkdir("sensors", 1,
+						hfs_mkdir("ssc_core", 1,
+							hfs_map_or_empty("ssc_hw_rev", ssc_hw_rev)
+						)
+					)
 				)
 			),
 			hfs_mkdir("system", 1,
-- 
2.56.0

