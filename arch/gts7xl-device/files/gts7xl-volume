#!/bin/sh
# Volume keys on the gts7xl: steps of 5 %, never above 60 % (micro-speakers distort above).
# gts7xl-volume raise|lower|mute-toggle
case ${1:-} in
raise) exec wpctl set-volume -l 0.6 @DEFAULT_AUDIO_SINK@ 5%+ ;;
lower) exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- ;;
mute-toggle) exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle ;;
*) echo "usage: gts7xl-volume raise|lower|mute-toggle" >&2; exit 2 ;;
esac
