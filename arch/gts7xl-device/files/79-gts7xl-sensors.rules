# gts7xl sensors through the SLPI (hexagonrpcd + libssc + iio-sensor-proxy).
# iio-sensor-proxy 3.9 only tags fastrpc-* with ssc-light and ssc-compass; the
# accelerometer (LSM6DSO, for screen rotation) must be enabled per device.
# The SLPI already turns the LSM6DSO axes into the Android device frame (stock registry
# lsm6dso_0_platform.orient: x = -y, y = +x, z = +z): identity matrix, to be corrected
# here after the first test on the tablet if rotation goes the wrong way.
SUBSYSTEM=="misc", KERNEL=="fastrpc-sdsp", ENV{IIO_SENSOR_PROXY_TYPE}+="ssc-accel", ENV{ACCEL_MOUNT_MATRIX}="1, 0, 0; 0, 1, 0; 0, 0, 1"
